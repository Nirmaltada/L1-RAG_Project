GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# Strict embedding mode switch:
# false = OpenRouter embedding models only
# true  = local all-MiniLM-L6-v2 only
USE_LOCAL_EMBEDDINGS=false
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_FALLBACK_MODELS=nvidia/llama-nemotron-embed-vl-1b-v2:free,liquid/lfm-2.5-embedding-350m:free
EMBEDDING_BATCH_SIZE=16
